{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"semi": true,
	"trailingComma": "none",
	"printWidth": 100,
	"insertFinalNewline": true,
	"sortImports": true,
	"sortPackageJson": true,
	"svelte": {
		"indentScriptAndStyle": true
	},
	"ignorePatterns": [
		"**/node_modules/**",
		"**/.svelte-kit/**",
		"**/build/**",
		"**/dist/**",
		"**/.turbo/**",
		"**/migrations/**",
		"ARCHITECTURE.md",
		"pnpm-lock.yaml"
	]
}
