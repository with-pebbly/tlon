# PostgreSQL started by `pnpm db:start` (project-local cluster, see scripts/pg-local.sh)
DATABASE_URL=postgres://tlon:tlon@127.0.0.1:54329/tlon
# Zero-setup alternative: embedded PGlite persisted to a directory
# DATABASE_URL=pglite:./.data/pglite
API_PORT=3001
API_HOST=127.0.0.1
# Human credential (>= 32 chars). Unset: generated on first boot into .data/admin-token (0600)
# TLON_ADMIN_TOKEN=
